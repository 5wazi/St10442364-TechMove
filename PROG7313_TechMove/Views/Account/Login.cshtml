@model PROG7313_TechMove.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign In";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — TechMove</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Google Fonts — same as _Layout.cshtml -->
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <style>
        /* ── CSS variables copied from _Layout.cshtml ── */
        :root {
            --accent: #c9a84c;
            --accent-dark: #a8873a;
            --surface: #f1f4f8;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --navbar-bg: #0f172a;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'IBM Plex Sans', sans-serif;
            background-color: var(--surface);
            color: var(--text-main);
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ── Top bar (matches app navbar) ── */
        .login-navbar {
            background-color: var(--navbar-bg);
            border-bottom: 1px solid rgba(255,255,255,0.06);
            padding: 0 1.5rem;
            height: 58px;
            display: flex;
            align-items: center;
            box-shadow: 0 2px 16px rgba(0,0,0,0.35);
        }

        .brand {
            font-family: 'IBM Plex Sans', sans-serif;
            font-weight: 600;
            font-size: 1.15rem;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-icon {
            background: var(--accent);
            color: #0f172a;
            width: 34px;
            height: 34px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .brand-sub {
            font-family: 'IBM Plex Sans', sans-serif;
            font-weight: 300;
            font-size: 0.72rem;
            color: #94a3b8;
            display: block;
            line-height: 1;
            margin-top: 2px;
            letter-spacing: 0.3px;
        }

        /* ── Page body ── */
        .login-body {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        /* ── Card ── */
        .login-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.07);
            width: 100%;
            max-width: 420px;
            overflow: hidden;
        }

        .login-card-header {
            background: var(--navbar-bg);
            padding: 1.4rem 1.8rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
        }

            .login-card-header .header-icon {
                width: 48px;
                height: 48px;
                background: var(--accent);
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.4rem;
                color: #0f172a;
                margin-bottom: 6px;
            }

            .login-card-header h1 {
                font-family: 'DM Serif Display', serif;
                font-weight: 400;
                font-size: 1.4rem;
                color: #fff;
                margin: 0;
                letter-spacing: 0.2px;
            }

            .login-card-header p {
                font-size: 0.8rem;
                color: #64748b;
                margin: 0;
                letter-spacing: 0.2px;
            }

        .login-card-body {
            padding: 1.8rem;
        }

        /* ── Form elements ── */
        .form-label {
            font-weight: 500;
            font-size: 0.82rem;
            color: #374151;
            margin-bottom: 0.4rem;
            display: block;
        }

        .form-control {
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 0.6rem 0.9rem;
            font-size: 0.875rem;
            background: #f8fafc;
            color: var(--text-main);
            width: 100%;
            transition: border-color 0.15s, box-shadow 0.15s;
            font-family: 'IBM Plex Sans', sans-serif;
        }

            .form-control:focus {
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(201, 168, 76, 0.15);
                background: #fff;
                outline: none;
            }

        /* ── Submit button ── */
        .btn-login {
            width: 100%;
            background-color: var(--accent);
            border: none;
            border-radius: 6px;
            padding: 0.65rem 1rem;
            font-family: 'IBM Plex Sans', sans-serif;
            font-weight: 600;
            font-size: 0.9rem;
            color: #0f172a;
            cursor: pointer;
            transition: background 0.2s, box-shadow 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 1.2rem;
        }

            .btn-login:hover {
                background-color: var(--accent-dark);
                box-shadow: 0 0 0 3px rgba(201, 168, 76, 0.2);
            }

            .btn-login:disabled {
                opacity: 0.65;
                cursor: not-allowed;
            }

        /* ── Alerts ── */
        .alert-error {
            background: #fef2f2;
            border: 1px solid #fca5a5;
            border-left: 3px solid #ef4444;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            font-size: 0.83rem;
            color: #7f1d1d;
            margin-bottom: 1.2rem;
            display: flex;
            align-items: flex-start;
            gap: 8px;
        }

        /* ── Loading spinner ── */
        .loading-state {
            text-align: center;
            padding: 1rem 0;
        }

            .loading-state .spinner-border {
                color: var(--accent);
                width: 2rem;
                height: 2rem;
            }

            .loading-state p {
                color: var(--text-muted);
                font-size: 0.85rem;
                margin-top: 0.75rem;
                margin-bottom: 0;
            }

        /* ── Divider ── */
        .login-divider {
            border: none;
            border-top: 1px solid var(--border);
            margin: 1.4rem 0;
        }

        .login-note {
            font-size: 0.78rem;
            color: var(--text-muted);
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        /* ── Footer ── */
        .login-footer {
            background-color: var(--navbar-bg);
            color: #334155;
            font-size: 0.75rem;
            border-top: 1px solid rgba(255,255,255,0.04);
            padding: 0.9rem 0;
            text-align: center;
            letter-spacing: 0.3px;
        }
    </style>
</head>
<body>

    <!-- Top bar -->
    <div class="login-navbar">
        <div class="brand">
            <div class="brand-icon"><i class="bi bi-truck"></i></div>
            <div>
                TechMove Logistics
                <span class="brand-sub">Enterprise Platform</span>
            </div>
        </div>
    </div>

    <!-- Login body -->
    <div class="login-body">
        <div class="login-card">

            <!-- Card header -->
            <div class="login-card-header">
                <div class="header-icon"><i class="bi bi-shield-lock"></i></div>
                <h1>Welcome Back</h1>
                <p>Sign in to access the logistics platform</p>
            </div>

            <!-- Card body -->
            <div class="login-card-body">

                @* Show server-side errors (e.g. API down, bad token) *@
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-error">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>
                            @foreach (var error in ViewData.ModelState.Values
                           .SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    </div>
                }

                @* Client-side error box — shown by JS when Firebase rejects login *@
                <div id="js-error" class="alert-error" style="display:none;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div id="js-error-text"></div>
                </div>

                @* Login form — visible while not loading *@
                <div id="login-form">
                    <div class="mb-3">
                        <label class="form-label" for="email">
                            <i class="bi bi-envelope me-1"></i>Email Address
                        </label>
                        <input id="email"
                               type="email"
                               class="form-control"
                               placeholder="you@@company.com"
                               autocomplete="email" />
                    </div>

                    <div class="mb-1">
                        <label class="form-label" for="password">
                            <i class="bi bi-lock me-1"></i>Password
                        </label>
                        <input id="password"
                               type="password"
                               class="form-control"
                               placeholder="••••••••"
                               autocomplete="current-password" />
                    </div>

                    <button id="login-btn" class="btn-login" onclick="signIn()">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Sign In
                    </button>
                </div>

                @* Loading state — shown by JS while Firebase is authenticating *@
                <div id="loading-state" class="loading-state" style="display:none;">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Signing in...</span>
                    </div>
                    <p>Verifying credentials…</p>
                </div>

                <hr class="login-divider" />

                <div class="login-note">
                    <i class="bi bi-shield-check" style="color: var(--accent);"></i>
                    Secured with Firebase Authentication
                </div>

            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="login-footer">
        &copy; 2026 TechMove Logistics — Global Logistics Management System
    </div>

    @*
        Hidden form that submits the Firebase ID token to the MVC backend.
        The Firebase JS SDK signs the user in client-side and returns an
        ID token. We POST that token to AccountController.Login which
        calls TechMove.Api to validate it and get back an internal JWT.
    *@
    <form id="token-form" method="post" action="/Account/Login" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="firebaseIdToken" id="firebaseIdToken" />
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    </form>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Firebase SDK v10 (modular, loaded as ES module) -->
    <script type="module">
        import { initializeApp }
            from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
        import { getAuth, signInWithEmailAndPassword }
            from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";

        // Values injected from AccountController via ViewBag
        const firebaseConfig = {
            apiKey:     "@ViewBag.FirebaseApiKey",
            authDomain: "@(ViewBag.FirebaseProjectId).firebaseapp.com",
            projectId:  "@ViewBag.FirebaseProjectId"
        };

        const app  = initializeApp(firebaseConfig);
        const auth = getAuth(app);

        // Expose signIn to the onclick handler on the button
        window.signIn = async function () {
            const email    = document.getElementById("email").value.trim();
            const password = document.getElementById("password").value;
            const errorBox = document.getElementById("js-error");
            const errorTxt = document.getElementById("js-error-text");
            const formEl   = document.getElementById("login-form");
            const loadEl   = document.getElementById("loading-state");
            const btn      = document.getElementById("login-btn");

            // Hide any previous error
            errorBox.style.display = "none";

            // Basic client-side validation
            if (!email || !password) {
                errorTxt.textContent = "Please enter your email address and password.";
                errorBox.style.display = "flex";
                return;
            }

            // Show loading state
            formEl.style.display  = "none";
            loadEl.style.display  = "block";
            btn.disabled          = true;

            try {
                // Sign in with Firebase
                const credential = await signInWithEmailAndPassword(
                    auth, email, password);

                // Get the Firebase ID token
                const idToken = await credential.user.getIdToken();

                // Put the token into the hidden form and submit it to the server
                document.getElementById("firebaseIdToken").value = idToken;
                document.getElementById("token-form").submit();

            } catch (err) {
                // Show Firebase error to the user
                loadEl.style.display = "none";
                formEl.style.display = "block";
                btn.disabled         = false;

                // Map Firebase error codes to friendly messages
                const messages = {
                    "auth/invalid-credential":     "Invalid email or password. Please try again.",
                    "auth/user-not-found":         "No account found with that email address.",
                    "auth/wrong-password":         "Incorrect password. Please try again.",
                    "auth/too-many-requests":      "Too many failed attempts. Please wait a moment and try again.",
                    "auth/user-disabled":          "This account has been disabled. Please contact support.",
                    "auth/network-request-failed": "Network error. Please check your internet connection."
                };

                errorTxt.textContent = messages[err.code]
                    ?? "Sign in failed: " + err.message;
                errorBox.style.display = "flex";
            }
        };

        // Allow pressing Enter to submit the form
        document.addEventListener("keydown", function (e) {
            if (e.key === "Enter") window.signIn();
        });
    </script>

</body>
</html>